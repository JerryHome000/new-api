{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["POST", "PUT", "PATCH", "DELETE"],
      "status": 405,
      "headers": { "Allow": "GET, HEAD" }
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
